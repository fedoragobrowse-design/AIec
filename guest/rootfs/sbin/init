#!/bin/sh
# PID 1 for the AIec Firecracker guest (Debian bookworm-slim rootfs).
#
# The guest address, gateway and DNS server come from the Firecracker boot
# cmdline (the kernel does IP autoconfiguration); this script only brings up
# the kernel filesystems and supervises the guest agent, which listens on vsock
# port 1024 and serves /workspace.
set -u

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH

log() {
  if [ -w /dev/console ]; then
    printf '%s\n' "$*" >/dev/console 2>/dev/null || true
  fi
  printf '%s\n' "$*" >>/run/aiec-init.log 2>/dev/null || true
}

mount -t proc proc /proc 2>/dev/null || log "WARN: could not mount /proc"
mount -t sysfs sysfs /sys 2>/dev/null || log "WARN: could not mount /sys"
mount -t devtmpfs devtmpfs /dev 2>/dev/null || log "WARN: could not mount devtmpfs on /dev"
mkdir -p /dev/pts /dev/shm /run /workspace
mount -t devpts devpts /dev/pts -o gid=5,mode=620 2>/dev/null || log "WARN: could not mount devpts"
mount -t tmpfs tmpfs /run -o mode=0755 2>/dev/null || true
# Fallback nodes for a kernel without CONFIG_DEVTMPFS_MOUNT.
[ -c /dev/null ] || mknod -m 0666 /dev/null c 1 3 2>/dev/null || true
[ -c /dev/zero ] || mknod -m 0666 /dev/zero c 1 5 2>/dev/null || true
[ -c /dev/console ] || mknod -m 0600 /dev/console c 5 1 2>/dev/null || true
[ -c /dev/ttyS0 ] || mknod -m 0620 /dev/ttyS0 c 4 64 2>/dev/null || true

if [ -r /etc/hostname ]; then
  hostname "$(cat /etc/hostname)" 2>/dev/null || log "WARN: could not set the hostname"
fi

if [ ! -s /etc/resolv.conf ]; then
  log "FATAL: /etc/resolv.conf is missing; the guest cannot resolve DNS"
  exec /bin/sh
fi

if [ ! -s /etc/aiec-guest-secret ]; then
  log "FATAL: guest secret is missing"
  exec /bin/sh
fi
AIEC_GUEST_SECRET=$(cat /etc/aiec-guest-secret)
export AIEC_GUEST_SECRET

AGENT=/usr/local/bin/aiec-guest
if [ ! -x "$AGENT" ]; then
  log "FATAL: $AGENT is missing"
  exec /bin/sh
fi

start_xvfb() {
  # Desktop profile only: the build stamps /etc/aiec-xvfb when Xvfb is
  # installed, and the base image carries no X server and must never try.
  # DISPLAY :99 matches what the desktop harness tool expects.
  [ -e /etc/aiec-xvfb ] || return 0
  [ -x /usr/bin/Xvfb ] || { log "WARN: /etc/aiec-xvfb present but Xvfb missing"; return 0; }
  DISPLAY=:99 /usr/bin/Xvfb :99 -screen 0 1280x1024x24 >/run/aiec-xvfb.log 2>&1 &
  echo $! >/run/aiec-xvfb.pid
  log "Xvfb started on :99 (pid $(cat /run/aiec-xvfb.pid))"
}

 start_agent() {
  # broken, and a guest agent that dies silently is undiagnosable.
  "$AGENT" >>/run/aiec-guest.log 2>>/dev/console &
  echo $! >/run/aiec-guest.pid
}

start_xvfb
start_agent
log "aiec-guest started (pid $(cat /run/aiec-guest.pid)), control port 1024"
while :; do
  pid=$(cat /run/aiec-guest.pid 2>/dev/null || echo 0)
  if ! kill -0 "$pid" 2>/dev/null; then
    log "aiec-guest exited; restarting"
    start_agent
  fi
  sleep 1
done
