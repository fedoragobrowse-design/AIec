#!/bin/sh
set -eu
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mkdir -p /dev/pts /run /workspace
mount -t devpts devpts /dev/pts 2>/dev/null || true
hostname agentforge-guest
if [ ! -r /etc/agentforge-guest-secret ]; then
  echo "FATAL: guest secret is missing" >/dev/console
  exec /bin/sh
fi
export AGENTFORGE_GUEST_SECRET="$(cat /etc/agentforge-guest-secret)"
/usr/local/bin/agentforge-guest >/run/agentforge-guest.log 2>&1 &
echo $! >/run/agentforge-guest.pid
echo "agentforge-guest started" >/dev/console
while :; do
  if ! /bin/kill -0 "$(cat /run/agentforge-guest.pid 2>/dev/null || echo 0)" 2>/dev/null; then
    /usr/local/bin/agentforge-guest >/run/agentforge-guest.log 2>&1 &
    echo $! >/run/agentforge-guest.pid
  fi
  sleep 1
done
